{
  "name": "ensemble-postoffice",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "description": "Client-agnostic remote mailbox MCP for Ensemble, Claude Code, Codex, and others",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.5"
  }
}
